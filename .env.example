# Copy to .env and adjust. Never commit a real .env.

# gRPC addresses of the three microservices (orchestrator connects to these)
PRODUCT_ADDR=localhost:50051
INVENTORY_ADDR=localhost:50052
ORDER_ADDR=localhost:50053

# Port the orchestrator's FastAPI app listens on
ORCHESTRATOR_PORT=8000

# SQLite database files, one per service (created from data/seed/ on first start)
PRODUCT_DB=data/products.db
INVENTORY_DB=data/inventory.db
ORDER_DB=data/orders.db

# Seconds between order status steps in the TrackOrder simulation (tests use ~0.05)
ORDER_SIM_STEP_SECONDS=2

# Optional LLM for intent detection and phrasing (any OpenAI-compatible Chat Completions API).
# Leave LLM_API_KEY empty to use the built-in rule-based parser (no network needed).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Seconds to wait for the LLM before falling back to rules
LLM_TIMEOUT=10
