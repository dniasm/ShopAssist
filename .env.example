# Copy to .env and adjust. Never commit a real .env. Never put real keys or passwords in this file.
# Secrets below are EMPTY on purpose: scripts/db_setup.py writes the database URLs and SESSION_SECRET.

# --- PostgreSQL (native binaries, see scripts/pg.py) -------------------------------
# Superuser URL, used only by scripts/db_setup.py and the test fixture. Format: postgresql://user:password@localhost:5432/postgres
PG_ADMIN_URL=
# Folder that holds pg_ctl and postgres binaries, and the cluster folder (e.g. C:\pgsql\bin and C:\pgdata\data)
PG_BIN=
PG_DATA=

# --- Per-service database URLs (written by scripts/db_setup.py; leave empty here) ---
CATALOG_DATABASE_URL=
INVENTORY_DATABASE_URL=
ORDER_DATABASE_URL=
CUSTOMER_DATABASE_URL=
PAYMENT_DATABASE_URL=

# --- gRPC addresses of the v2 services (orchestrator connects to these) -----------
CATALOG_ADDR=localhost:50051
INVENTORY_ADDR=localhost:50052
ORDER_ADDR=localhost:50053
CUSTOMER_ADDR=localhost:50054
PAYMENT_ADDR=localhost:50055

# Port the orchestrator's FastAPI app listens on
ORCHESTRATOR_PORT=8011

# Signs session tokens. Written by scripts/db_setup.py when missing; leave empty here.
SESSION_SECRET=

# --- Business timing ---------------------------------------------------------------
# Seconds a stock reservation lasts before it expires
RESERVATION_TTL_SECONDS=600
# Seconds between fulfilment steps (CONFIRMED -> PACKED -> ...). Tests use ~0.05
FULFILMENT_STEP_SECONDS=8
# Simulated payment latency in milliseconds
PAYMENT_LATENCY_MS=300

# --- v1 settings (still read by scripts/run_all.py until Phase 5.5 removes v1) -----
PRODUCT_ADDR=localhost:50051
INVENTORY_ADDR=localhost:50052
ORDER_ADDR=localhost:50053
PRODUCT_DB=data/products.db
INVENTORY_DB=data/inventory.db
ORDER_DB=data/orders.db
ORDER_SIM_STEP_SECONDS=2

# --- Optional LLM for intent detection (Groq, OpenAI-compatible Chat Completions) ---
# With no keys, the built-in rule-based parser answers everything, with no network needed.

# Groq base URL
LLM_BASE_URL=https://api.groq.com/openai/v1

# Groq API keys, comma-separated, no spaces needed (e.g. key1,key2,key3). Leave empty to use rules only.
# The legacy single-key variable LLM_API_KEY is still accepted and merged into this list.
LLM_API_KEYS=

# Model name
LLM_MODEL=openai/gpt-oss-120b

# Reasoning effort sent to the model: low, medium or high
LLM_REASONING_EFFORT=low

# Maximum completion tokens per request (sent as max_completion_tokens)
LLM_MAX_TOKENS=1024

# Total seconds for one intent detection, across all key attempts; then rules take over
LLM_TIMEOUT=10

# Per-key limits the app plans around. These are Groq's base values; match them to
# what console.groq.com/settings/limits shows for your organisation.
# Requests per minute per key
LLM_LIMIT_RPM=30
# Requests per day per key
LLM_LIMIT_RPD=1000
# Tokens per minute per key
LLM_LIMIT_TPM=8000
# Tokens per day per key
LLM_LIMIT_TPD=200000
